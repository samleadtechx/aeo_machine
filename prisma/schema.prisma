generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  ACTIVE
  PAUSED
}

enum DomainMode {
  SUBFOLDER
  SUBDOMAIN_ROOT
}

enum DeploymentType {
  SFTP
  FTP
  FTPS
}

enum CleanUrlMode {
  HTML
  HTACCESS_DIRECTORY
}

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ArticleSource {
  MANUAL
  BABYLOVEGROWTH
  MCP
  IMPORT
}

enum SeoGateStatus {
  PASS
  FAIL
  WARNING
}

enum FunnelType {
  QUIZ_2_OPTION_CALCULATOR
}

enum FunnelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlacementMatchMode {
  ANY_TAG
  ALL_TAGS
}

enum FunnelPlacement {
  AFTER_INTRO
  MIDDLE
  BEFORE_CONCLUSION
  END
}

enum LeadQualifiedStatus {
  UNKNOWN
  QUALIFIED
  UNQUALIFIED
}

enum TrackingProvider {
  META
  TIKTOK
  REDDIT
  OPENAI_ADS
}

enum TrackingEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AnalyticsEventType {
  ARTICLE_OPEN
  DEEP_READ
  LEAD
}

enum OutboundWebhookMethod {
  POST
  PUT
  PATCH
}

enum OutboundDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum BuildReason {
  MANUAL
  ARTICLE_PUBLISH
  FUNNEL_UPDATE
  SETTINGS_UPDATE
}

enum DeploymentStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum IntegrationProvider {
  BABYLOVEGROWTH
  META
  TIKTOK
  REDDIT
  OPENAI_ADS
}

enum PublicWebhookType {
  LEAD_INGEST
  TRACKING_EVENT
  BABYLOVEGROWTH
}

enum ImageOutputFormat {
  ORIGINAL
  WEBP
  JPEG
  PNG
}

enum SeoIssueSeverity {
  BLOCKER
  WARNING
  INFO
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id                      String                  @id @default(cuid())
  name                    String
  slug                    String                  @unique
  status                  BlogStatus              @default(ACTIVE)
  baseUrl                 String                  @unique
  domainMode              DomainMode              @default(SUBFOLDER)
  language                String                  @default("en")
  timezone                String                  @default("America/Chicago")
  brandName               String
  logoMediaId             String?
  faviconMediaId          String?
  primaryColor            String                  @default("#2563eb")
  accentColor             String                  @default("#0f766e")
  fontFamily              String                  @default("Inter, ui-sans-serif, system-ui")
  defaultAuthorName       String                  @default("Editorial Team")
  defaultAuthorBio        String?
  organizationName        String?
  organizationLogoMediaId String?
  robotsPolicy            String                  @default("index,follow")
  indexNowEnabled         Boolean                 @default(false)
  indexNowKey             String?
  imageOptimizationEnabled Boolean                @default(true)
  imageOutputFormat       ImageOutputFormat       @default(WEBP)
  imageQuality            Int                     @default(82)
  imageMaxWidth           Int                     @default(1600)
  logoMaxWidth            Int                     @default(480)
  themeKey                String                  @default("default-saas-blog")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  articles                Article[]
  tags                    Tag[]
  mediaAssets             MediaAsset[]
  funnels                 Funnel[]
  placementRules          FunnelPlacementRule[]
  leads                   Lead[]
  analyticsEvents         AnalyticsEvent[]
  trackingEvents          TrackingEvent[]
  outboundWebhooks        OutboundWebhook[]
  integrationCredentials  IntegrationCredential[]
  babyLoveGrowthImports   BabyLoveGrowthImport[]
  publicWebhookEndpoints  PublicWebhookEndpoint[]
  builds                  Build[]
  deployments             Deployment[]
  deploymentTargets       DeploymentTarget[]
}

model DeploymentTarget {
  id                            String         @id @default(cuid())
  blogId                        String
  type                          DeploymentType
  host                          String
  port                          Int
  username                      String
  passwordEncrypted             String?
  privateKeyEncrypted           String?
  privateKeyPassphraseEncrypted String?
  remoteRootPath                String
  cleanUrlMode                  CleanUrlMode   @default(HTACCESS_DIRECTORY)
  phpEnabled                    Boolean        @default(true)
  htaccessEnabled               Boolean        @default(true)
  lastTestedAt                  DateTime?
  lastTestStatus                String?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  blog                          Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  deployments                   Deployment[]

  @@index([blogId])
}

model Article {
  id                    String                 @id @default(cuid())
  blogId                String
  title                 String
  slug                  String
  status                ArticleStatus          @default(DRAFT)
  source                ArticleSource          @default(MANUAL)
  sourceExternalId      String?
  markdown              String
  htmlCache             String?
  excerpt               String?
  metaTitle             String?
  metaDescription       String?
  canonicalUrl          String?
  heroMediaId           String?
  heroAlt               String?
  authorName            String?
  publishedAt           DateTime?
  updatedAt             DateTime               @updatedAt
  createdAt             DateTime               @default(now())
  seoScore              Int                    @default(0)
  seoGateStatus         SeoGateStatus          @default(FAIL)
  seoGateDetailsJson    Json?
  schemaJson            Json?
  faqJson               Json?
  noindex               Boolean                @default(false)
  blog                  Blog                   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tags                  ArticleTag[]
  leads                 Lead[]
  analyticsEvents       AnalyticsEvent[]
  seoAuditIssues        SeoAuditIssue[]
  babyLoveGrowthImports BabyLoveGrowthImport[]

  @@unique([blogId, slug])
  @@unique([blogId, source, sourceExternalId])
  @@index([blogId, status])
}

model Tag {
  id        String       @id @default(cuid())
  blogId    String
  name      String
  slug      String
  blog      Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([blogId, slug])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  blogId       String?
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  storagePath  String
  publicPath   String
  altText      String?
  hash         String?
  createdAt    DateTime @default(now())
  blog         Blog?    @relation(fields: [blogId], references: [id], onDelete: SetNull)

  @@index([blogId])
  @@index([hash])
}

model Funnel {
  id             String                @id @default(cuid())
  blogId         String?
  name           String
  slug           String
  type           FunnelType            @default(QUIZ_2_OPTION_CALCULATOR)
  status         FunnelStatus          @default(DRAFT)
  configJson     Json
  styleJson      Json?
  trackingJson   Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  blog           Blog?                 @relation(fields: [blogId], references: [id], onDelete: Cascade)
  placementRules FunnelPlacementRule[]
  leads          Lead[]

  @@unique([blogId, slug])
}

model FunnelPlacementRule {
  id           String             @id @default(cuid())
  blogId       String
  funnelId     String
  name         String
  enabled      Boolean            @default(true)
  matchMode    PlacementMatchMode @default(ANY_TAG)
  tagSlugsJson Json
  placement    FunnelPlacement    @default(END)
  priority     Int                @default(100)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  blog         Blog               @relation(fields: [blogId], references: [id], onDelete: Cascade)
  funnel       Funnel             @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([funnelId])
}

model Lead {
  id                 String                    @id @default(cuid())
  blogId             String
  funnelId           String?
  articleId          String?
  remoteSubmissionId String
  email              String?
  phone              String?
  name               String?
  fieldsJson         Json?
  answersJson        Json?
  resultJson         Json?
  resultText         String?
  utmJson            Json?
  trackingJson       Json?
  ipHash             String?
  userAgent          String?
  referrer           String?
  sourceUrl          String?
  eventId            String?
  qualifiedStatus    LeadQualifiedStatus       @default(UNKNOWN)
  createdAt          DateTime                  @default(now())
  blog               Blog                      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  funnel             Funnel?                   @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  article            Article?                  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  analyticsEvents    AnalyticsEvent[]
  trackingEvents     TrackingEvent[]
  outboundDeliveries OutboundWebhookDelivery[]

  @@unique([blogId, remoteSubmissionId])
  @@index([blogId])
  @@index([funnelId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  blogId      String
  articleId   String?
  leadId      String?
  eventType   AnalyticsEventType
  eventName   String
  eventId     String
  visitorId   String?
  sessionId   String?
  sourceUrl   String?
  landingUrl  String?
  articleSlug String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  utmJson     Json?
  queryJson   Json?
  deviceJson  Json?
  requestJson Json?
  payloadJson Json?
  createdAt   DateTime           @default(now())
  blog        Blog               @relation(fields: [blogId], references: [id], onDelete: Cascade)
  article     Article?           @relation(fields: [articleId], references: [id], onDelete: SetNull)
  lead        Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([blogId, eventId, eventType])
  @@index([blogId, createdAt])
  @@index([articleId, createdAt])
  @@index([eventType, createdAt])
  @@index([visitorId])
  @@index([sessionId])
}

model TrackingEvent {
  id          String              @id @default(cuid())
  blogId      String
  leadId      String?
  provider    TrackingProvider
  eventName   String
  eventId     String
  eventTime   DateTime            @default(now())
  sourceUrl   String?
  payloadJson Json
  status      TrackingEventStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?
  blog        Blog                @relation(fields: [blogId], references: [id], onDelete: Cascade)
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId, eventName])
  @@index([status])
}

model OutboundWebhook {
  id                   String                    @id @default(cuid())
  blogId               String?
  name                 String
  enabled              Boolean                   @default(true)
  urlEncrypted         String
  method               OutboundWebhookMethod     @default(POST)
  headersEncryptedJson String?
  secretEncrypted      String?
  eventTypesJson       Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  blog                 Blog?                     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  deliveries           OutboundWebhookDelivery[]

  @@index([blogId])
}

model OutboundWebhookDelivery {
  id                String                 @id @default(cuid())
  outboundWebhookId String
  leadId            String
  status            OutboundDeliveryStatus @default(PENDING)
  attempts          Int                    @default(0)
  requestJson       Json?
  responseStatus    Int?
  responseBody      String?
  lastError         String?
  createdAt         DateTime               @default(now())
  sentAt            DateTime?
  outboundWebhook   OutboundWebhook        @relation(fields: [outboundWebhookId], references: [id], onDelete: Cascade)
  lead              Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([outboundWebhookId, leadId])
  @@index([status, createdAt])
}

model Build {
  id           String       @id @default(cuid())
  blogId       String
  status       BuildStatus  @default(QUEUED)
  reason       BuildReason  @default(MANUAL)
  outputPath   String?
  manifestJson Json?
  fileCount    Int?
  sizeBytes    Int?
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?
  createdAt    DateTime     @default(now())
  blog         Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  deployments  Deployment[]

  @@index([blogId])
}

model Deployment {
  id            String           @id @default(cuid())
  blogId        String
  buildId       String
  targetId      String
  status        DeploymentStatus @default(QUEUED)
  uploadedFiles Int              @default(0)
  deletedFiles  Int              @default(0)
  skippedFiles  Int              @default(0)
  logJson       Json?
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?
  createdAt     DateTime         @default(now())
  blog          Blog             @relation(fields: [blogId], references: [id], onDelete: Cascade)
  build         Build            @relation(fields: [buildId], references: [id], onDelete: Cascade)
  target        DeploymentTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([buildId])
}

model IntegrationCredential {
  id                   String              @id @default(cuid())
  blogId               String?
  provider             IntegrationProvider
  name                 String
  enabled              Boolean             @default(true)
  secretsEncryptedJson String?
  settingsJson         Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  blog                 Blog?               @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model BabyLoveGrowthImport {
  id                String   @id @default(cuid())
  blogId            String
  externalArticleId String
  status            String
  articleId         String?
  rawPayloadJson    Json
  createdAt         DateTime @default(now())
  blog              Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  article           Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([blogId, externalArticleId])
}

model PublicWebhookEndpoint {
  id              String            @id @default(cuid())
  blogId          String
  type            PublicWebhookType
  publicId        String            @unique
  secretEncrypted String
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  blog            Blog              @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model McpToken {
  id              String    @id @default(cuid())
  name            String
  tokenHash       String    @unique
  enabled         Boolean   @default(true)
  blogScopeJson   Json?
  permissionsJson Json
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SeoAuditIssue {
  id          String           @id @default(cuid())
  articleId   String
  severity    SeoIssueSeverity
  code        String
  message     String
  detailsJson Json?
  createdAt   DateTime         @default(now())
  article     Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(QUEUED)
  payloadJson Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
}
